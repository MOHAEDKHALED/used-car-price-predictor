{
  "info": {
    "name": "🚗 Used Car Price Predictor API",
    "_postman_id": "used-car-api-collection-v1",
    "description": "Complete API test collection for the Used Car Price Predictor.\n\n## How to use\n1. Run the API first: `python api.py`\n2. Import this file into Postman\n3. Run individual requests or use **Collection Runner** to run all at once\n\n## Base URL\nhttp://127.0.0.1:5000",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "📋 1. Index — Welcome & Endpoints",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        },
        "description": "Returns a welcome message and lists all available API endpoints."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is JSON', () => {",
              "  pm.response.to.be.json;",
              "});",
              "",
              "pm.test('status == ok', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('ok');",
              "});",
              "",
              "pm.test('endpoints key exists', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('endpoints');",
              "});",
              "",
              "pm.test('message key exists', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('message');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "Expected Response",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"status\": \"ok\",\n  \"message\": \"Used Car Price Predictor API is running 🚗\",\n  \"endpoints\": {\n    \"GET  /\": \"This help message\",\n    \"GET  /health\": \"Health check\",\n    \"GET  /options\": \"Valid dropdown values\",\n    \"POST /predict\": \"Predict car selling price\"\n  }\n}"
        }
      ]
    },
    {
      "name": "❤️ 2. Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Checks if the API is alive and the model is loaded."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('status == healthy', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('healthy');",
              "});",
              "",
              "pm.test('model_loaded is true', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.model_loaded).to.be.true;",
              "});",
              "",
              "pm.test('Response time < 500ms', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "Expected Response",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"status\": \"healthy\",\n  \"model_loaded\": true\n}"
        }
      ]
    },
    {
      "name": "📂 3a. Options — All Brands & Models",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/options",
          "host": ["{{base_url}}"],
          "path": ["options"]
        },
        "description": "Returns all valid values for brands, models, fuel types, and transmission types."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('brands is non-empty array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.brands).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('models is non-empty array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.models).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('fuel_types is non-empty array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.fuel_types).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('transmission_types is non-empty array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.transmission_types).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('Has at least 10 brands', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.brands.length).to.be.at.least(10);",
              "});",
              "",
              "// Save brands to environment for later use",
              "const body = pm.response.json();",
              "pm.environment.set('available_brands', JSON.stringify(body.brands));",
              "pm.environment.set('available_fuel_types', JSON.stringify(body.fuel_types));",
              "pm.environment.set('available_transmissions', JSON.stringify(body.transmission_types));",
              "",
              "console.log('✅ Brands:', body.brands.length, 'total');",
              "console.log('✅ Models:', body.models.length, 'total');",
              "console.log('✅ Fuel types:', body.fuel_types);",
              "console.log('✅ Transmissions:', body.transmission_types);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "Expected Response",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"brands\": [\"Ashok\", \"Audi\", \"BMW\", \"Chevrolet\", \"Datsun\", \"Fiat\", \"Force\", \"Ford\", \"Honda\", \"Hyundai\", \"Isuzu\", \"Jaguar\", \"Jeep\", \"Kia\", \"Land\", \"Lexus\", \"MG\", \"Mahindra\", \"Maruti\", \"Mercedes-Benz\", \"Mini\", \"Mitsubishi\", \"Nissan\", \"Opel\", \"Porsche\", \"Renault\", \"Skoda\", \"Tata\", \"Toyota\", \"Volkswagen\", \"Volvo\", \"isuzu\"],\n  \"models\": [\"...\"],\n  \"fuel_types\": [\"CNG\", \"Diesel\", \"Electric\", \"LPG\", \"Petrol\"],\n  \"transmission_types\": [\"Automatic\", \"Manual\"]\n}"
        }
      ]
    },
