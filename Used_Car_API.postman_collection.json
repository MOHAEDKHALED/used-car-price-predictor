        {
          "name": "Expected Response",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"brands\": [\"...\"],\n  \"models\": [\"Alto\", \"Baleno\", \"Brezza\", \"Ciaz\", \"Dzire\", \"Eeco\", \"Ertiga\", \"Ignis\", \"S-Cross\", \"S-Presso\", \"Swift\", \"Swift Dzire\", \"SX4\", \"Wagon R\", \"XL6\", \"Zen\"],\n  \"fuel_types\": [\"CNG\", \"Diesel\", \"Electric\", \"LPG\", \"Petrol\"],\n  \"transmission_types\": [\"Automatic\", \"Manual\"]\n}"
