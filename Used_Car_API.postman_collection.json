    {
      "name": "🎯 4a. Predict — Maruti Swift (Standard)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/predict",
          "host": ["{{base_url}}"],
          "path": ["predict"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_age\": 5,\n  \"km_driven\": 50000,\n  \"fuel_type\": \"Petrol\",\n  \"transmission_type\": \"Manual\",\n  \"brand\": \"Maruti\",\n  \"model\": \"Swift\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Standard prediction: 5-year-old Maruti Swift, Petrol, Manual, 50k km."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('predicted_price exists', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('predicted_price');",
              "});",
              "",
              "pm.test('currency is INR', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.currency).to.eql('INR');",
              "});",
              "",
              "pm.test('input is echoed back', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('input');",
              "});",
              "",
              "pm.test('predicted_price is a positive number', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.predicted_price).to.be.a('number');",
              "  pm.expect(body.predicted_price).to.be.above(0);",
              "});",
              "",
              "pm.test('predicted_price in plausible range (₹10k – ₹1cr)', () => {",
              "  const price = pm.response.json().predicted_price;",
              "  pm.expect(price).to.be.within(10000, 10000000);",
              "});",
              "",
              "pm.test('Response time < 2000ms', () => {",
              "  pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "const price = pm.response.json().predicted_price;",
              "console.log('💰 Predicted Price: ₹' + price.toLocaleString('en-IN'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "response": [
        {
          "name": "Expected Response",
          "status": "OK",
          "code": 200,
          "body": "{\n  \"predicted_price\": 479882.86,\n  \"currency\": \"INR\",\n  \"input\": {\n    \"vehicle_age\": 5,\n    \"km_driven\": 50000,\n    \"fuel_type\": \"Petrol\",\n    \"transmission_type\": \"Manual\",\n    \"brand\": \"Maruti\",\n    \"model\": \"Swift\"\n  }\n}"
        }
      ]
    },
